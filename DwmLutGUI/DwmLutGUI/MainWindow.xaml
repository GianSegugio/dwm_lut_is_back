<Window x:Class="DwmLutGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DwmLutGUI"
        mc:Ignorable="d"
        Title="DwmLutGUI" Height="420" Width="840" MinHeight="320" MinWidth="720">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <local:LutFileNameConverter x:Key="LutFileName" />

        <!-- One row definition set, shared by the label column and every monitor column, so the
             transposed table lines up without a DataGrid. -->
        <!-- Alternating row tint: a few percent of white over the #121212 background, so the light
             band lifts just slightly and the dark band stays exactly as the base surface. -->
        <SolidColorBrush x:Key="RowStripeBrush" Color="#FFFFFF" Opacity="0.05" />

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,8,0" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- BasedOn is essential: App.xaml declares an implicit Button style carrying the dark
             ControlTemplate. A bare TargetType="Button" style REPLACES it, which is what made these
             buttons fall back to the default light Windows chrome. -->
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="MinWidth" Value="54" />
        </Style>
        <!-- Long .cube names must not widen the column, so the item text is clipped and the full
             path is available on hover instead. -->
        <Style x:Key="LutItemText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource BackgroundBrush}">
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding ActiveText, StringFormat=Status: {0}}" />
        </StatusBar>

        <DockPanel Margin="6" Background="{StaticResource BackgroundBrush}">

            <!-- Bottom bar: hotkey on the left, LUT + gamma actions on the right -->
            <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <Button Content="About" Width="75" Click="AboutButton_Click" />
                    <TextBlock Text="Hotkey" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <ComboBox x:Name="ToggleKeyCombo" SelectedItem="{Binding ToggleKey}" MinWidth="110"
                              VerticalAlignment="Center"
                              ToolTip="Global key that applies or disables all LUTs" />
                </StackPanel>
                <Grid HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding GammaFixLabel}"
                               VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,6,6" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Width="60" Margin="0,0,6,6"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding GammaFixValues}"
                              SelectedItem="{Binding SelectedGammaValue}"
                              ToolTip="Target gamma the piecewise sRGB curve is replaced with. 2.2 = PC/sRGB nominal, 2.4 = BT.1886 (dark room), 2.6 = DCI. If the fix is already on, switch it Off and On again for a new value to take effect." />
                    <Button Grid.Row="0" Grid.Column="2" Content="On" Width="75"
                            Margin="0,0,6,6" IsEnabled="{Binding CanEnableGammaFix}" Click="GammaFixOn_Click"
                            ToolTip="Patch DWM's SDR-to-HDR conversion so SDR content is decoded with the selected pure gamma curve instead of the piecewise sRGB curve, fixing washed-out SDR content in HDR mode. Native HDR content is unaffected. This RESTARTS DWM (brief black flash) because the shaders must be patched before DWM creates them." />
                    <Button Grid.Row="0" Grid.Column="3" Content="Off" Width="75" Margin="0,0,0,6"
                            IsEnabled="{Binding CanDisableGammaFix}" Click="GammaFixOff_Click"
                            ToolTip="Restore Windows' stock piecewise sRGB curve for SDR content. Also restarts DWM." />

                    <TextBlock Grid.Row="1" Grid.Column="1" Text="LUT:" VerticalAlignment="Center"
                               TextAlignment="Right" Margin="0,0,6,0" />
                    <Button Grid.Row="1" Grid.Column="2" IsEnabled="{Binding CanApply}" Content="Apply"
                            Width="75" Margin="0,0,6,0" Click="Apply_Click" />
                    <Button Grid.Row="1" Grid.Column="3" Content="Disable" Width="75"
                            IsEnabled="{Binding IsActive}" Click="Disable_Click" />
                </Grid>
            </Grid>

            <!-- Transposed monitor table: properties are rows, monitors are columns. Each column is
                 self-contained (its own LUT pickers and buttons), so there is no "selected monitor". -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal" Grid.IsSharedSizeScope="True">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" SharedSizeGroup="R0" />
                            <RowDefinition Height="Auto" SharedSizeGroup="R1" />
                            <RowDefinition Height="Auto" SharedSizeGroup="R2" />
                            <RowDefinition Height="Auto" SharedSizeGroup="R3" />
                            <RowDefinition Height="Auto" SharedSizeGroup="R4" />
                            <RowDefinition Height="Auto" SharedSizeGroup="R5" />
                            <RowDefinition Height="Auto" SharedSizeGroup="R6" />
                            <RowDefinition Height="Auto" SharedSizeGroup="R7" />
                            <RowDefinition Height="Auto" SharedSizeGroup="R8" />
                            <RowDefinition Height="Auto" SharedSizeGroup="R9" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="1" Background="{StaticResource RowStripeBrush}" />
                        <Border Grid.Row="3" Background="{StaticResource RowStripeBrush}" />
                        <Border Grid.Row="5" Background="{StaticResource RowStripeBrush}" />
                        <Border Grid.Row="8" Grid.RowSpan="2" Background="{StaticResource RowStripeBrush}" />

                        <TextBlock Grid.Row="0" Text="Monitor"   Style="{StaticResource RowLabel}" FontWeight="Bold" />
                        <TextBlock Grid.Row="1" Text="#"         Style="{StaticResource RowLabel}" />
                        <TextBlock Grid.Row="2" Text="Connector" Style="{StaticResource RowLabel}" />
                        <TextBlock Grid.Row="3" Text="Position"  Style="{StaticResource RowLabel}" />
                        <TextBlock Grid.Row="4" Text="Mode"      Style="{StaticResource RowLabel}" />
                        <TextBlock Grid.Row="5" Text="Status"    Style="{StaticResource RowLabel}" />
                        <TextBlock Grid.Row="6" Text="SDR LUT"   Style="{StaticResource RowLabel}" Margin="6,6,8,0" />
                        <TextBlock Grid.Row="7" Text=""          Style="{StaticResource RowLabel}" />
                        <TextBlock Grid.Row="8" Text="HDR LUT"   Style="{StaticResource RowLabel}" Margin="6,6,8,0" />
                        <TextBlock Grid.Row="9" Text=""          Style="{StaticResource RowLabel}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Monitors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#40808080" BorderThickness="1,0,0,0">
                                    <Grid Width="231">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" SharedSizeGroup="R0" />
                                            <RowDefinition Height="Auto" SharedSizeGroup="R1" />
                                            <RowDefinition Height="Auto" SharedSizeGroup="R2" />
                                            <RowDefinition Height="Auto" SharedSizeGroup="R3" />
                                            <RowDefinition Height="Auto" SharedSizeGroup="R4" />
                                            <RowDefinition Height="Auto" SharedSizeGroup="R5" />
                                            <RowDefinition Height="Auto" SharedSizeGroup="R6" />
                                            <RowDefinition Height="Auto" SharedSizeGroup="R7" />
                                            <RowDefinition Height="Auto" SharedSizeGroup="R8" />
                            <RowDefinition Height="Auto" SharedSizeGroup="R9" />
                                        </Grid.RowDefinitions>


                                        <Border Grid.Row="1" Background="{StaticResource RowStripeBrush}" />
                                        <Border Grid.Row="3" Background="{StaticResource RowStripeBrush}" />
                                        <Border Grid.Row="5" Background="{StaticResource RowStripeBrush}" />
                                        <Border Grid.Row="8" Grid.RowSpan="2" Background="{StaticResource RowStripeBrush}" />

                                        <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold"
                                                   Margin="8,0,8,0" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DevicePath}" />
                                        <TextBlock Grid.Row="1" Text="{Binding DisplayIndex}"
                                                   Style="{StaticResource CellText}" />
                                        <TextBlock Grid.Row="2" Text="{Binding Connector}" Style="{StaticResource CellText}" />
                                        <TextBlock Grid.Row="3" Text="{Binding Position}"  Style="{StaticResource CellText}" />
                                        <TextBlock Grid.Row="4" Text="{Binding HdrStatus}" Style="{StaticResource CellText}" />
                                        <TextBlock Grid.Row="5" Text="{Binding Status}"    Style="{StaticResource CellText}" />

                                        <ComboBox Grid.Row="6" Margin="8,6,8,0" ItemsSource="{Binding SdrLuts}"
                                                  SelectedItem="{Binding SdrLutPath, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="SDR LUT for this monitor (empty = none)">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource LutFileName}}"
                                                               Style="{StaticResource LutItemText}"
                                                               ToolTip="{Binding}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="8,3,8,0">
                                            <Button Content="Browse" Style="{StaticResource MiniButton}"
                                                    Click="SdrLutBrowse_Click"
                                                    ToolTip="Pick an SDR LUT file for this monitor" />
                                            <Button Content="Next" Style="{StaticResource MiniButton}"
                                                    Click="SwitchSdrLut_Click"
                                                    ToolTip="Cycle this monitor to its next SDR LUT" />
                                            <Button Content="Clear" Style="{StaticResource MiniButton}"
                                                    Click="DeleteSdrLut_Click"
                                                    ToolTip="Remove the current SDR LUT from this monitor's list" />
                                        </StackPanel>

                                        <ComboBox Grid.Row="8" Margin="8,6,8,0" ItemsSource="{Binding HdrLuts}"
                                                  SelectedItem="{Binding HdrLutPath, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="HDR LUT for this monitor (empty = none)">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource LutFileName}}"
                                                               Style="{StaticResource LutItemText}"
                                                               ToolTip="{Binding}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="8,3,8,0">
                                            <Button Content="Browse" Style="{StaticResource MiniButton}"
                                                    Click="HdrLutBrowse_Click"
                                                    ToolTip="Pick an HDR LUT file for this monitor" />
                                            <Button Content="Next" Style="{StaticResource MiniButton}"
                                                    Click="SwitchHdrLut_Click"
                                                    ToolTip="Cycle this monitor to its next HDR LUT" />
                                            <Button Content="Clear" Style="{StaticResource MiniButton}"
                                                    Click="DeleteHdrLut_Click"
                                                    ToolTip="Remove the current HDR LUT from this monitor's list" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </DockPanel>
</Window>
